wire-format 1

protocol backend-test
description "Exercises compiled field representations"

byte-order little-endian
bit-order lsb-first

message crossing
description "Cross-octet bits followed by little-endian scalars"
field first bits 5
constant marker bits 2 = 2
field second bits 9
field count u32
field wide u64
vector nominal
first = 0x15
second = 0x12d
count = 0x12345678
wide = 0xfedcba9876543210
wire d5 96 78 56 34 12 10 32 54 76 98 ba dc fe
end-vector
end-message

message bit63
description "Largest signed-stack bit field"
field value bits 63
constant stop bits 1 = 0
vector maximum
value = 0x7fffffffffffffff
wire ff ff ff ff ff ff ff 7f
end-vector
end-message

message fixed
description "Constants with no caller fields"
constant bit-marker bits 64 = 0xfedcba9876543210
constant scalar-marker u64 = 0x0123456789abcdef
vector nominal
wire 10 32 54 76 98 ba dc fe
wire ef cd ab 89 67 45 23 01
end-vector
end-message

end-protocol
