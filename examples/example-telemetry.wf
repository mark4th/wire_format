wire-format 1

protocol example-telemetry
description "A small example used to exercise the source compiler"
standard "Example 1"
reference "doc/WF_FILE_FORMAT.md"

byte-order big-endian
bit-order msb-first

message status
description "A three-octet status record"

field version bits 3
constant reserved bits 1 = 0
field mode bits 4
field sample-count u16

vector nominal
version = 1
mode = 2
sample-count = 0x1234
wire 22 12 34
end-vector

end-message
end-protocol
