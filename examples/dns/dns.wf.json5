{
  wire_format: 1,

  protocol: {
    name: 'dns',
    description: 'Fixed-size DNS query and response records used by the demo',
    standard: 'RFC 1035',
    reference: 'RFC 1035 sections 4.1.1, 4.1.2, and 4.1.3',
    byte_order: 'big-endian',
    bit_order: 'msb-first',

    messages: [
      {
        name: 'query-header',
        description: 'DNS query header with empty answer and authority sections',
        fields: [
          { name: 'transaction-id', type: 'u16' },
          { name: 'flags', type: 'u16' },
          { name: 'question-count', type: 'u16' },
          { name: 'answer-count', type: 'u16', constant: 0 },
          { name: 'authority-count', type: 'u16', constant: 0 },
          { name: 'additional-count', type: 'u16', constant: 0 },
        ],
        vectors: [{
          name: 'single-question',
          values: {
            'transaction-id': 0x1234,
            flags: 0x0100,
            'question-count': 1,
          },
          wire: [
            0x12, 0x34, 0x01, 0x00, 0x00, 0x01,
            0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
          ],
        }],
      },

      {
        name: 'question-tail',
        description: 'Fixed fields following a variable-length encoded QNAME',
        fields: [
          { name: 'query-type', type: 'u16' },
          { name: 'query-class', type: 'u16' },
        ],
        vectors: [{
          name: 'ipv4-internet',
          values: { 'query-type': 1, 'query-class': 1 },
          wire: [0x00, 0x01, 0x00, 0x01],
        }],
      },

      {
        name: 'response-header',
        description: 'Complete fixed-size DNS response header',
        fields: [
          { name: 'transaction-id', type: 'u16' },
          { name: 'flags', type: 'u16' },
          { name: 'question-count', type: 'u16' },
          { name: 'answer-count', type: 'u16' },
          { name: 'authority-count', type: 'u16' },
          { name: 'additional-count', type: 'u16' },
        ],
        vectors: [{
          name: 'two-answers',
          values: {
            'transaction-id': 0x1234,
            flags: 0x8180,
            'question-count': 1,
            'answer-count': 2,
            'authority-count': 0,
            'additional-count': 0,
          },
          wire: [
            0x12, 0x34, 0x81, 0x80, 0x00, 0x01,
            0x00, 0x02, 0x00, 0x00, 0x00, 0x00,
          ],
        }],
      },

      {
        name: 'resource-record',
        description: 'Fixed fields following a resource-record NAME',
        fields: [
          { name: 'record-type', type: 'u16' },
          { name: 'record-class', type: 'u16' },
          { name: 'ttl', type: 'u32' },
          { name: 'data-length', type: 'u16' },
        ],
        vectors: [{
          name: 'ipv4-five-minutes',
          values: {
            'record-type': 1,
            'record-class': 1,
            ttl: 300,
            'data-length': 4,
          },
          wire: [0x00, 0x01, 0x00, 0x01, 0x00, 0x00, 0x01, 0x2c, 0x00, 0x04],
        }],
      },
    ],
  },
}
